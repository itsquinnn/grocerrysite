# =============================================================================
# DOVAN Backend Environment Template
# Duplicate this file as .env.local and fill in your private credentials
# NEVER commit .env.local or production service role keys to git!
# =============================================================================

PORT=3002
NODE_ENV=development

# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Secret Service Role Key (Found in Supabase Dashboard > Settings > API > service_role)
# CRITICAL: Bypasses Row Level Security — keep this strictly confidential
SUPABASE_SERVICE_ROLE_KEY=""

# Master OTP for local testing bypass
MASTER_OTP="123456"

# Optional: Email Notifications (Resend / SMTP)
# RESEND_API_KEY=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# EMAIL_FROM="Dovan <noreply@dovan.com>"

