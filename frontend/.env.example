# =============================================================================
# DOVAN Frontend Environment Template
# Duplicate this file as .env and fill in your project credentials
# =============================================================================

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# API Backend URL (in dev, defaults to '/api' which Vite proxies to localhost:3002)
VITE_API_URL="/api"

